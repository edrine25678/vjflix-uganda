{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build && npm run vercel:assets",
  "installCommand": "npm install",
  "outputDirectory": "public/static-deploy",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.php"
    }
  ],
  "env": {
    "APP_NAME": "VJFlix Uganda",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_URL": "https://vjflix-uganda.vercel.app",
    "LOG_CHANNEL": "stderr",
    "LOG_LEVEL": "error",

    "APP_TIMEZONE": "Africa/Kampala",
    "TIMEZONE": "Africa/Kampala",
    "APP_LOCALE": "en",
    "APP_FALLBACK_LOCALE": "en",
    "APP_FAKER_LOCALE": "en_US",

    "APP_MAINTENANCE_DRIVER": "file",

    "BROADCAST_CONNECTION": "log",
    "CACHE_STORE": "array",
    "SESSION_DRIVER": "cookie",
    "SESSION_LIFETIME": "120",
    "QUEUE_CONNECTION": "sync",
    "FILESYSTEM_DISK": "local",

    "APP_EVENTS_CACHE": "/tmp/events.php",
    "APP_ROUTES_CACHE": "/tmp/routes.php",
    "APP_SERVICES_CACHE": "/tmp/bootstrap/cache/services.php",
    "APP_PACKAGES_CACHE": "/tmp/bootstrap/cache/packages.php",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "LARAVEL_STORAGE_PATH": "/tmp/storage",

    "DB_CONNECTION": "pgsql",
    "DB_PORT": "5432",
    "DB_DATABASE": "neondb",
    "DB_SSLMODE": "require"
  }
}
